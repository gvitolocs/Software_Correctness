{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "PLPA Graphics IDE (JavaFX)",
      "request": "launch",
      "mainClass": "plpa.graphics.Main",
      "projectName": "graphics-ide",
      "vmArgs": "--module-path \"${env:HOME}/.m2/repository/org/openjfx/javafx-base/17.0.2/javafx-base-17.0.2-linux.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-graphics/17.0.2/javafx-graphics-17.0.2-linux.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-controls/17.0.2/javafx-controls-17.0.2-linux.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-fxml/17.0.2/javafx-fxml-17.0.2-linux.jar\" --add-modules javafx.controls,javafx.fxml"
    }
  ]
}
