{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "PLPA Graphics IDE (Run with Maven)",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/run-javafx.js",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "PLPA Graphics IDE (JavaFX)",
      "request": "launch",
      "mainClass": "plpa.graphics.Main",
      "projectName": "graphics-ide",
      "javaExec": "${env:JAVA_HOME}/bin/java",
      "vmArgs": "--module-path \"${env:HOME}/.m2/repository/org/openjfx/javafx-base/21.0.7/javafx-base-21.0.7-mac-aarch64.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-graphics/21.0.7/javafx-graphics-21.0.7-mac-aarch64.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-controls/21.0.7/javafx-controls-21.0.7-mac-aarch64.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-fxml/21.0.7/javafx-fxml-21.0.7-mac-aarch64.jar\" --add-modules javafx.controls,javafx.fxml",
      "console": "integratedTerminal"
    }
  ]
}
